generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ProjectVisibility {
  PRIVATE
  SPECIFIC
  TEAM
  PUBLIC
}

enum MemberRoleType {
  OWNER
  PARTICIPANT
  VIEWER
  FOLLOWER
}

enum TaskStatus {
  TODO
  READY
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RelationType {
  DOCUMENT
  CUSTOMER
  OPPORTUNITY
  APPROVAL
  SCHEDULE
  DATA
  PROJECT
  OTHER
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_CLOSED
  PROJECT_REOPENED
  MEMBER_ADDED
  MEMBER_REMOVED
  SHARE_ADDED
  SHARE_REMOVED
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_COMPLETED
  TASK_DATES_UPDATED
  TASK_DEPENDENCY_CREATED
  TASK_DEPENDENCY_DELETED
  COMMENT_ADDED
  RELATION_ADDED
  RELATION_REMOVED
  URGED
  FORWARDED
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String?            @unique
  createdProjects   Project[]          @relation("ProjectCreator")
  ownedProjects     Project[]          @relation("ProjectOwner")
  projectMembers    ProjectMember[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  reportedTasks     Task[]             @relation("TaskReporter")
  taskComments      TaskComment[]
  projectActivities ProjectActivity[]
  readLogs          ProjectReadLog[]
  auditLogs         ProjectAuditLog[]
  urgesSent         ProjectUrge[]      @relation("UrgeSender")
  urgesReceived     ProjectUrge[]      @relation("UrgeReceiver")
  attachments       Attachment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Project {
  id                 String            @id @default(cuid())
  name               String
  description        String?
  ownerId            String
  creatorId          String
  startDate          DateTime?
  endDate            DateTime?
  status             ProjectStatus     @default(ACTIVE)
  priority           Int               @default(0)
  visibilityScope    ProjectVisibility @default(PRIVATE)
  reminderConfigJson Json?
  closedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  owner      User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  creator    User               @relation("ProjectCreator", fields: [creatorId], references: [id])
  members    ProjectMember[]
  tags       ProjectTag[]
  taskGroups TaskGroup[]
  tasks      Task[]
  relations  ProjectRelation[]
  activities ProjectActivity[]
  readLogs   ProjectReadLog[]
  auditLogs  ProjectAuditLog[]
  urges      ProjectUrge[]

  @@index([ownerId])
  @@index([creatorId])
  @@index([status])
  @@index([updatedAt])
}

model ProjectMember {
  id        String         @id @default(cuid())
  projectId String
  userId    String
  roleType  MemberRoleType
  joinedAt  DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, roleType])
  @@index([projectId])
  @@index([userId])
}

model ProjectTag {
  id        String   @id @default(cuid())
  projectId String
  tagName   String
  tagType   String   @default("PUBLIC")
  createdBy String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tagName])
}

model TaskGroup {
  id        String   @id @default(cuid())
  projectId String
  name      String
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([projectId, sortOrder])
}

model Task {
  id              String       @id @default(cuid())
  projectId       String
  groupId         String?
  title           String
  description     String?
  assigneeId      String?
  reporterId      String?
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)
  progressPercent Int          @default(0)
  startAt         DateTime?
  endAt           DateTime?
  dueAt           DateTime?
  durationDays    Int?
  sortOrder       Int          @default(0)
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group            TaskGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter         User?            @relation("TaskReporter", fields: [reporterId], references: [id])
  comments         TaskComment[]
  predecessorLinks TaskDependency[] @relation("DependencySuccessor")
  successorLinks   TaskDependency[] @relation("DependencyPredecessor")

  @@index([projectId])
  @@index([groupId])
  @@index([assigneeId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([projectId, sortOrder])
}

model TaskDependency {
  id                String         @id @default(cuid())
  projectId         String
  predecessorTaskId String
  successorTaskId   String
  dependencyType    DependencyType @default(FS)
  lagDays           Int            @default(0)
  createdBy         String?
  createdAt         DateTime       @default(now())

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTask Task    @relation("DependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   Task    @relation("DependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId, dependencyType])
  @@index([projectId])
  @@index([predecessorTaskId])
  @@index([successorTaskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model ProjectRelation {
  id           String       @id @default(cuid())
  projectId    String
  relationType RelationType
  targetId     String
  targetTitle  String
  sourceType   String?
  extraJson    Json?
  createdBy    String?
  createdAt    DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([relationType])
}

model ProjectActivity {
  id             String       @id @default(cuid())
  projectId      String
  actorId        String
  activityType   ActivityType
  targetType     String?
  targetId       String?
  contentSummary String
  extraJson      Json?
  createdAt      DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([actorId])
  @@index([activityType])
  @@index([createdAt])
}

model ProjectReadLog {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  clientType String?
  readAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([readAt])
}

model ProjectAuditLog {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  moduleName String
  actionName String
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model ProjectUrge {
  id         String   @id @default(cuid())
  projectId  String
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender   User    @relation("UrgeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("UrgeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([senderId])
  @@index([receiverId])
}

model Attachment {
  id         String   @id @default(cuid())
  bizType    String
  bizId      String
  fileName   String
  fileUrl    String
  fileSize   Int?
  uploaderId String
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([bizType, bizId])
  @@index([uploaderId])
}
